# development | production | test
# In production, JWT_SECRET / DATABASE_URL / FRONTEND_URL below are required
# and validated at startup (see src/env.ts) — the app refuses to boot with
# missing or default values rather than silently running insecurely.
NODE_ENV=development

# Port the Express server listens on.
PORT=3000

# Secret used to sign JWTs. MUST be a long random value in production —
# generate one with: openssl rand -base64 32
JWT_SECRET=dev-secret

# SQLite connection string. Relative paths are resolved by Prisma relative
# to prisma/schema.prisma's own directory (backend/prisma/), NOT the process
# cwd — so "./dev.db" here means backend/prisma/dev.db, and a value like
# "./prisma/dev.db" would actually resolve to the nested, ungitignored
# backend/prisma/prisma/dev.db. Prefer an absolute path if that's ever
# unclear. In production, point this at a file on a persistent volume (see
# fly.toml) so a redeploy doesn't wipe your data — most PaaS free tiers use
# ephemeral disks otherwise. A Postgres URL also works here; only the
# datasource `provider` in prisma/schema.prisma would need to change.
DATABASE_URL=file:./dev.db

# Origin the backend accepts CORS/cookie requests from. In production, set
# this to your deployed frontend's real origin (or your single deployed
# origin, if the backend is serving the built frontend itself).
FRONTEND_URL=http://localhost:5173
